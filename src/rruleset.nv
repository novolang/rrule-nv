// rruleset.nv — a `DTSTART`, the rules that generate from it, and the
// dates added and removed by hand.
//
// A RECURRENCE IS NOT A RULE.  IT IS A SET.
//
// RFC 5545 § 3.8.5 builds the recurrence set from four properties:
// `RRULE` generates, `RDATE` adds, `EXDATE` removes, and `DTSTART`
// anchors the whole of it.  The order is fixed and it matters:
// exclusion happens LAST, so a date in both `RDATE` and `EXDATE` is
// excluded.  A library that exposed only the rule cannot express the
// series everybody actually has — the weekly meeting, moved once,
// cancelled twice.
//
// `DTSTART` IS ALWAYS THE FIRST OCCURRENCE, AND WHEN IT SHOULD NOT BE
// THE CALLER IS TOLD
//
// Here is the one place the specification leaves a hole and every
// implementation fills it differently.  RFC 5545 § 3.8.5.3 says the
// `DTSTART` counts as the first recurrence instance, and it also says
// that a `DTSTART` not synchronised with the rule gives an UNDEFINED
// recurrence set.  So `DTSTART=2026-01-07` — a Wednesday — with
// `FREQ=WEEKLY;BYDAY=MO` has a first occurrence that the rule would
// never have produced, and the reference implementations disagree
// about whether to yield it.
//
// This package yields it, because that is what the specification's
// normative sentence says and because dropping a start date silently
// loses the one occurrence the organiser definitely meant.  And
// `is_synchronized` is published, so a caller who wants the other
// behaviour can detect the case and a calendar editor can warn about
// it at the moment the rule is written rather than never.
//
// THE OCCURRENCES ARE CIVIL, AND THERE IS NO ZONE HERE
//
// Every date in a set is one of calendar-nv's civil values: a wall
// clock with no zone attached.  That is not a simplification, it is
// what RFC 5545 means — a recurrence is defined on the local
// calendar, which is why a daily 09:00 meeting stays at 09:00 across
// a daylight-saving change while the instant it names moves by an
// hour.
//
// Converting each civil occurrence to an instant is a separate step
// with its own failure mode — twice a year a wall time happened twice
// or never happened — and tz-nv is the package that answers it.
// Keeping that out is what lets this package be `core`, and what lets
// a test generate a year of occurrences with no clock and no zone
// database.

use civil
use rruleerror
use rrulespec

// A recurrence set: where it starts, what generates it, and what was
// added and removed by hand.
//
// ```novo
// use civil
// use rruleset
//
// fn main() [io]
//     match civil.date(2026, 1, 5)
//         Err(_) => println("not a date")
//         Ok(d)  =>
//             let s = rruleset.set(civil.datetime(d, civil.midnight()), true)
//             println("${rruleset.rule_count(s)}")     // 0
// ```
pub struct RruleSet
    // The anchor, and the first occurrence.  Its time of day is the
    // time of day every generated occurrence takes unless a `BYHOUR`,
    // `BYMINUTE` or `BYSECOND` part replaces it.
    dtstart: civil.CivilDateTime
    // Whether the set is date-valued.  RFC 5545 lets `DTSTART` be a
    // DATE or a DATE-TIME, and the choice travels through the whole
    // set: it decides what `UNTIL` must be, and whether the time half
    // of every occurrence means anything.  A set that mixed the two
    // could not be one list, so this is a field of the set and not of
    // an occurrence.
    date_valued: Bool
    // The `RRULE` properties.  RFC 5545 permits more than one and
    // their occurrences are unioned, which is rare and is what a
    // "first Monday and last Friday" series is written as by
    // servers that will not use `BYSETPOS`.
    rules: [rrulespec.Rrule]
    // The `RDATE` properties: occurrences added regardless of the
    // rules.
    rdates: [civil.CivilDateTime]
    // The `EXDATE` properties: occurrences removed, applied after
    // everything else.
    exdates: [civil.CivilDateTime]

// A set with a start and nothing else.
//
// `date_valued` says whether `DTSTART` was a DATE — a whole-day
// series — or a DATE-TIME.
//
// ```novo
// use civil
// use rruleset
//
// fn main() [io]
//     match civil.date(2026, 1, 5)
//         Err(_) => println("not a date")
//         Ok(d)  =>
//             let s = rruleset.set(civil.datetime(d, civil.midnight()), true)
//             println("${rruleset.is_date_valued(s)}")    // true
// ```
pub fn set(dtstart: civil.CivilDateTime, date_valued: Bool) -> RruleSet []
    todo("rrule-nv.rruleset.set")

// The same set with one more `RRULE`.
//
// ```novo
// use civil
// use rrulespec
// use rruleset
//
// fn main() [io]
//     match civil.date(2026, 1, 5)
//         Err(_) => println("not a date")
//         Ok(d)  =>
//             let s = rruleset.set(civil.datetime(d, civil.midnight()), true)
//             println("${rruleset.rule_count(rruleset.with_rule(s, rrulespec.rule(RruleWeekly)))}")
// ```
pub fn with_rule(s: RruleSet, r: rrulespec.Rrule) -> RruleSet []
    todo("rrule-nv.rruleset.with_rule")

// The same set with one more `RDATE`.
//
// An `RDATE` is an occurrence the rules did not produce — the week
// the meeting moved to a Thursday.  It is added whatever the rules
// say, and it can still be removed by an `EXDATE`.
//
// ```novo
// use civil
// use rruleset
//
// fn main() [io]
//     match civil.date(2026, 1, 5)
//         Err(_) => println("not a date")
//         Ok(d)  =>
//             let s = rruleset.set(civil.datetime(d, civil.midnight()), true)
//             println("${list.len(rruleset.with_rdate(s, civil.datetime(d, civil.midnight())).rdates)}")
// ```
pub fn with_rdate(s: RruleSet, at: civil.CivilDateTime) -> RruleSet []
    todo("rrule-nv.rruleset.with_rdate")

// The same set with one more `EXDATE`.
//
// Exclusion is applied LAST, so an instant that is both an `RDATE`
// and an `EXDATE` is excluded.  RFC 5545 § 3.8.5.1 fixes that order,
// and the other order produces a cancelled meeting that reappears.
//
// ```novo
// use civil
// use rruleset
//
// fn main() [io]
//     match civil.date(2026, 1, 5)
//         Err(_) => println("not a date")
//         Ok(d)  =>
//             let s = rruleset.set(civil.datetime(d, civil.midnight()), true)
//             println("${list.len(rruleset.with_exdate(s, civil.datetime(d, civil.midnight())).exdates)}")
// ```
pub fn with_exdate(s: RruleSet, at: civil.CivilDateTime) -> RruleSet []
    todo("rrule-nv.rruleset.with_exdate")

// The set's `DTSTART`.
//
// ```novo
// use civil
// use rruleset
//
// fn main() [io]
//     match civil.date(2026, 1, 5)
//         Err(_) => println("not a date")
//         Ok(d)  =>
//             let s = rruleset.set(civil.datetime(d, civil.midnight()), true)
//             println("${rruleset.dtstart_of(s).date.day}")    // 5
// ```
pub fn dtstart_of(s: RruleSet) -> civil.CivilDateTime []
    todo("rrule-nv.rruleset.dtstart_of")

// Whether the set is date-valued — a whole-day series.
//
// A caller that renders occurrences reads this before it prints a
// time, and a caller that builds an `UNTIL` reads it to know which
// value type is allowed.
//
// ```novo
// use civil
// use rruleset
//
// fn main() [io]
//     match civil.date(2026, 1, 5)
//         Err(_) => println("not a date")
//         Ok(d)  =>
//             let s = rruleset.set(civil.datetime(d, civil.midnight()), false)
//             println("${rruleset.is_date_valued(s)}")     // false
// ```
pub fn is_date_valued(s: RruleSet) -> Bool []
    todo("rrule-nv.rruleset.is_date_valued")

// How many `RRULE` properties the set carries.
//
// ```novo
// use civil
// use rruleset
//
// fn main() [io]
//     match civil.date(2026, 1, 5)
//         Err(_) => println("not a date")
//         Ok(d)  =>
//             let s = rruleset.set(civil.datetime(d, civil.midnight()), true)
//             println("${rruleset.rule_count(s)}")         // 0
// ```
pub fn rule_count(s: RruleSet) -> Int []
    todo("rrule-nv.rruleset.rule_count")

// Whether the rules would themselves have produced the `DTSTART`.
//
// False is not an error.  It is RFC 5545 § 3.8.5.3's undefined case,
// which this package resolves by yielding the `DTSTART` anyway — so
// this predicate is how a calendar editor warns at the moment the
// rule is written, and how a caller who wants the other behaviour
// detects it.  A set with no rules is synchronised by definition.
//
// ```novo
// use civil
// use rrulespec
// use rruleset
//
// fn main() [io]
//     match civil.date(2026, 1, 7)
//         Err(_) => println("not a date")
//         Ok(wed) =>
//             let s = rruleset.set(civil.datetime(wed, civil.midnight()), true)
//             let weekly = rrulespec.rule(RruleWeekly)
//             println("${rruleset.is_synchronized(rruleset.with_rule(s, weekly))}")
// ```
pub fn is_synchronized(s: RruleSet) -> Bool []
    todo("rrule-nv.rruleset.is_synchronized")

// Every problem with the set, or an empty list when there is none.
//
// Runs `rrulespec.check` over each rule and adds the two checks that
// need the `DTSTART`: that an `UNTIL`'s value type matches it, and
// that a date-valued set carries no `BYHOUR`, `BYMINUTE` or
// `BYSECOND` — parts that can only mean something when there is a
// time of day to replace.
//
// ```novo
// use civil
// use rruleset
//
// fn main() [io]
//     match civil.date(2026, 1, 5)
//         Err(_) => println("not a date")
//         Ok(d)  =>
//             let s = rruleset.set(civil.datetime(d, civil.midnight()), true)
//             println("${list.len(rruleset.check_set(s))}")     // 0
// ```
pub fn check_set(s: RruleSet) -> [rruleerror.RruleError] []
    todo("rrule-nv.rruleset.check_set")
