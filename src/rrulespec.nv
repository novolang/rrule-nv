// rrulespec — the recurrence rule as a value, and the table that
// decides what it means.
//
// RFC 5545 section 3.3.10 carries a table with one row per `BYxxx` part
// and one column per frequency, and every cell says one of two words:
// the part expands the set the frequency generated, or it limits it.
// That table is the whole of what a rule means.  A wrong cell raises
// nothing: the rule still runs and generates a different series.
// `FREQ=WEEKLY;BYMONTH=1` limits, keeping the weekly occurrences that
// fall in January.  An implementation that expanded it would produce a
// series nobody wrote.  So `part_role` is public and total, and a test
// asserts the table against the specification's printed copy.
//
// It is not a function of the frequency alone.  Both of the table's
// footnotes are about `BYDAY`.  Under `MONTHLY` it expands, unless
// `BYMONTHDAY` is present, and then it limits.  Under `YEARLY` it limits
// when `BYYEARDAY` or `BYMONTHDAY` is present.  So `part_role` takes the
// whole rule.
//
// `BYSETPOS` is applied last, to one interval's whole set:
// `FREQ=MONTHLY;BYDAY=MO,TU,WE,TH,FR;BYSETPOS=-1` is the last weekday of
// the month, and "last" means something only once the month's set
// exists.  The generator in `rruleiter` works an interval at a time for
// that reason, and `BYSETPOS` with no other part is refused.

use std.list
use civil
use rruleerror
use rrulefreq

// What a `BYxxx` part does to the set its frequency generated.
//
// ```novo
// use rrulespec
//
// fn main() [io]
//     println(rrulespec.role_name(RruleExpands))     // expands
// ```
pub enum RruleExpansion
    // The part multiplies the set: each occurrence the frequency
    // produced becomes one occurrence per value of the part.
    RruleExpands
    // The part filters the set: an occurrence survives only if it
    // agrees with one of the part's values.
    RruleLimits
    // The part is not applicable to this frequency at all, and a rule
    // carrying it is refused rather than run.
    RruleNotApplicable

// When a rule stops.
//
// ```novo
// use rrulespec
//
// fn main() [io]
//     match rrulespec.end_count(RruleCount(10))
//         Some(n) => println("${n}")      // 10
//         None    => println("no count")
// ```
pub enum RruleEnd
    // The rule generates occurrences forever.  This is the default,
    // and it is why no function in `rruleiter` answers a list without
    // a bound.
    RruleNever
    // The rule generates exactly this many occurrences, counting the
    // `DTSTART` as the first.
    RruleCount(n: Int)
    // The rule generates occurrences up to and including this wall
    // time.  `kind` is the value type `UNTIL` was written in, which must
    // match `DTSTART`'s; see `RruleUntilKindMismatch`.
    RruleUntil(at: civil.CivilDateTime, kind: RruleUntilKind)

// The value type an `UNTIL` was written in (RFC 5545 section 3.3.10).
//
// A `UTC` one is compared with the occurrences as written.  A caller
// whose `DTSTART` carries a time zone converts it to that zone's wall
// time first, with tz-nv, because this package has no zones.
pub enum RruleUntilKind
    // A DATE: `UNTIL=19971224`.  The last day is included whole.
    RruleUntilDate
    // A DATE-TIME with no zone: `UNTIL=19971224T000000`.
    RruleUntilLocal
    // A DATE-TIME in UTC: `UNTIL=19971224T000000Z`.
    RruleUntilUtc

// A recurrence rule: one `FREQ`, an interval, an end, a week start,
// and the nine `BYxxx` lists.
//
// Every list is empty in a rule built by `rule`, and an empty list
// means the part is absent — which is not the same as a part present
// with no values, a thing RFC 5545's grammar cannot express.
//
// ```novo
// use rrulespec
//
// fn main() [io]
//     let r = rrulespec.with_interval(rrulespec.rule(RruleWeekly), 2)
//     println("${r.interval}")        // 2
// ```
pub struct Rrule
    // The frequency.  The one part RFC 5545 § 3.3.10 requires.
    freq: rrulefreq.RruleFreq
    // How many frequency units between intervals.  Positive; `1`
    // unless `INTERVAL` said otherwise.
    interval: Int
    // When the rule stops.
    end: RruleEnd
    // The day a week starts on, which decides which occurrences of a
    // weekly rule fall in which interval and which week an ISO week
    // number names.  RFC 5545's default is Monday.
    wkst: civil.Weekday
    // `BYSECOND`.
    by_second: [Int]
    // `BYMINUTE`.
    by_minute: [Int]
    // `BYHOUR`.
    by_hour: [Int]
    // `BYDAY`, each value a weekday with an ordinal.
    by_day: [rrulefreq.RruleWeekdayNum]
    // `BYMONTHDAY`, negative values counting from the end of the
    // month.
    by_monthday: [Int]
    // `BYYEARDAY`, negative values counting from the end of the year.
    by_yearday: [Int]
    // `BYWEEKNO`, only under a yearly rule.
    by_weekno: [Int]
    // `BYMONTH`.
    by_month: [Int]
    // `BYSETPOS`, applied last to one interval's set.
    by_setpos: [Int]

// A rule with a frequency and nothing else: interval 1, no end, week
// starting on Monday, every `BYxxx` list empty.
//
// ```novo
// use rrulefreq
// use rrulespec
//
// fn main() [io]
//     let r = rrulespec.rule(RruleDaily)
//     println(rrulefreq.freq_name(r.freq))      // DAILY
// ```
pub fn rule(freq: rrulefreq.RruleFreq) -> Rrule []
    Rrule {
        freq: freq,
        interval: 1,
        end: RruleNever,
        wkst: Mon,
        by_second: [],
        by_minute: [],
        by_hour: [],
        by_day: [],
        by_monthday: [],
        by_yearday: [],
        by_weekno: [],
        by_month: [],
        by_setpos: [] }

// The same rule with a different `INTERVAL`.
//
// The value is not checked here — a constructor has no error channel
// — and `check` is where a zero or negative interval is refused.
//
// ```novo
// use rrulespec
//
// fn main() [io]
//     println("${rrulespec.with_interval(rrulespec.rule(RruleDaily), 3).interval}")
// ```
pub fn with_interval(r: Rrule, interval: Int) -> Rrule []
    Rrule {
        freq: r.freq,
        interval: interval,
        end: r.end,
        wkst: r.wkst,
        by_second: r.by_second,
        by_minute: r.by_minute,
        by_hour: r.by_hour,
        by_day: r.by_day,
        by_monthday: r.by_monthday,
        by_yearday: r.by_yearday,
        by_weekno: r.by_weekno,
        by_month: r.by_month,
        by_setpos: r.by_setpos }

// The same rule with a different end.
//
// ```novo
// use rrulespec
//
// fn main() [io]
//     let r = rrulespec.with_end(rrulespec.rule(RruleDaily), RruleCount(5))
//     println("${rrulespec.is_finite(r)}")      // true
// ```
pub fn with_end(r: Rrule, end: RruleEnd) -> Rrule []
    Rrule {
        freq: r.freq,
        interval: r.interval,
        end: end,
        wkst: r.wkst,
        by_second: r.by_second,
        by_minute: r.by_minute,
        by_hour: r.by_hour,
        by_day: r.by_day,
        by_monthday: r.by_monthday,
        by_yearday: r.by_yearday,
        by_weekno: r.by_weekno,
        by_month: r.by_month,
        by_setpos: r.by_setpos }

// The same rule with a different week start.
//
// It changes the answer for a weekly rule with an interval above one,
// and for any rule using `BYWEEKNO`.  `FREQ=WEEKLY;INTERVAL=2;BYDAY=SU,MO`
// puts the Sunday and the Monday in the same interval under
// `WKST=SU` and in different intervals under `WKST=MO`, which is a
// two-week difference in a fortnightly rota.
//
// ```novo
// use civil
// use rrulespec
//
// fn main() [io]
//     let r = rrulespec.with_wkst(rrulespec.rule(RruleWeekly), Sun)
//     println("${civil.weekday_number(r.wkst)}")     // 7
// ```
pub fn with_wkst(r: Rrule, wkst: civil.Weekday) -> Rrule []
    Rrule {
        freq: r.freq,
        interval: r.interval,
        end: r.end,
        wkst: wkst,
        by_second: r.by_second,
        by_minute: r.by_minute,
        by_hour: r.by_hour,
        by_day: r.by_day,
        by_monthday: r.by_monthday,
        by_yearday: r.by_yearday,
        by_weekno: r.by_weekno,
        by_month: r.by_month,
        by_setpos: r.by_setpos }

// The same rule with a `BYDAY` list.
//
// ```novo
// use civil
// use rrulefreq
// use rrulespec
//
// fn main() [io]
//     let last_fri = rrulefreq.weekday_num(Fri, -1)
//     let r = rrulespec.with_by_day(rrulespec.rule(RruleMonthly), [last_fri])
//     println("${list.len(r.by_day)}")       // 1
// ```
pub fn with_by_day(r: Rrule, by_day: [rrulefreq.RruleWeekdayNum]) -> Rrule []
    Rrule {
        freq: r.freq,
        interval: r.interval,
        end: r.end,
        wkst: r.wkst,
        by_second: r.by_second,
        by_minute: r.by_minute,
        by_hour: r.by_hour,
        by_day: by_day[:],
        by_monthday: r.by_monthday,
        by_yearday: r.by_yearday,
        by_weekno: r.by_weekno,
        by_month: r.by_month,
        by_setpos: r.by_setpos }

// The same rule with a `BYMONTH` list.
//
// ```novo
// use rrulespec
//
// fn main() [io]
//     let r = rrulespec.with_by_month(rrulespec.rule(RruleYearly), [1, 7])
//     println("${list.len(r.by_month)}")     // 2
// ```
pub fn with_by_month(r: Rrule, by_month: [Int]) -> Rrule []
    Rrule {
        freq: r.freq,
        interval: r.interval,
        end: r.end,
        wkst: r.wkst,
        by_second: r.by_second,
        by_minute: r.by_minute,
        by_hour: r.by_hour,
        by_day: r.by_day,
        by_monthday: r.by_monthday,
        by_yearday: r.by_yearday,
        by_weekno: r.by_weekno,
        by_month: by_month[:],
        by_setpos: r.by_setpos }

// The same rule with a `BYMONTHDAY` list.
//
// ```novo
// use rrulespec
//
// fn main() [io]
//     let r = rrulespec.with_by_monthday(rrulespec.rule(RruleMonthly), [-1])
//     println("${r.by_monthday[0]}")         // -1
// ```
pub fn with_by_monthday(r: Rrule, by_monthday: [Int]) -> Rrule []
    Rrule {
        freq: r.freq,
        interval: r.interval,
        end: r.end,
        wkst: r.wkst,
        by_second: r.by_second,
        by_minute: r.by_minute,
        by_hour: r.by_hour,
        by_day: r.by_day,
        by_monthday: by_monthday[:],
        by_yearday: r.by_yearday,
        by_weekno: r.by_weekno,
        by_month: r.by_month,
        by_setpos: r.by_setpos }

// The same rule with a `BYYEARDAY` list.
//
// ```novo
// use rrulespec
//
// fn main() [io]
//     let r = rrulespec.with_by_yearday(rrulespec.rule(RruleYearly), [1, -1])
//     println("${list.len(r.by_yearday)}")   // 2
// ```
pub fn with_by_yearday(r: Rrule, by_yearday: [Int]) -> Rrule []
    Rrule {
        freq: r.freq,
        interval: r.interval,
        end: r.end,
        wkst: r.wkst,
        by_second: r.by_second,
        by_minute: r.by_minute,
        by_hour: r.by_hour,
        by_day: r.by_day,
        by_monthday: r.by_monthday,
        by_yearday: by_yearday[:],
        by_weekno: r.by_weekno,
        by_month: r.by_month,
        by_setpos: r.by_setpos }

// The same rule with a `BYWEEKNO` list.
//
// Only a yearly rule may carry one; `check` answers
// `RruleByWeekNoNeedsYearly` for any other.
//
// ```novo
// use rrulespec
//
// fn main() [io]
//     let r = rrulespec.with_by_weekno(rrulespec.rule(RruleYearly), [20])
//     println("${r.by_weekno[0]}")           // 20
// ```
pub fn with_by_weekno(r: Rrule, by_weekno: [Int]) -> Rrule []
    Rrule {
        freq: r.freq,
        interval: r.interval,
        end: r.end,
        wkst: r.wkst,
        by_second: r.by_second,
        by_minute: r.by_minute,
        by_hour: r.by_hour,
        by_day: r.by_day,
        by_monthday: r.by_monthday,
        by_yearday: r.by_yearday,
        by_weekno: by_weekno[:],
        by_month: r.by_month,
        by_setpos: r.by_setpos }

// The same rule with a `BYSETPOS` list.
//
// ```novo
// use civil
// use rrulefreq
// use rrulespec
//
// fn main() [io]
//     let weekdays = [rrulefreq.weekday_num(Mon, 0), rrulefreq.weekday_num(Fri, 0)]
//     let r = rrulespec.with_by_day(rrulespec.rule(RruleMonthly), weekdays)
//     println("${list.len(rrulespec.with_by_setpos(r, [-1]).by_setpos)}")    // 1
// ```
pub fn with_by_setpos(r: Rrule, by_setpos: [Int]) -> Rrule []
    Rrule {
        freq: r.freq,
        interval: r.interval,
        end: r.end,
        wkst: r.wkst,
        by_second: r.by_second,
        by_minute: r.by_minute,
        by_hour: r.by_hour,
        by_day: r.by_day,
        by_monthday: r.by_monthday,
        by_yearday: r.by_yearday,
        by_weekno: r.by_weekno,
        by_month: r.by_month,
        by_setpos: by_setpos[:] }

// The same rule with `BYHOUR`, `BYMINUTE` and `BYSECOND` lists.
//
// One function rather than three, because a rule that sets any of the
// three almost always sets the ones below it: `BYHOUR=9` on its own
// takes the minute and the second from `DTSTART`, which is correct
// and surprises people.
//
// ```novo
// use rrulespec
//
// fn main() [io]
//     let r = rrulespec.with_by_time(rrulespec.rule(RruleDaily), [9, 17], [0], [0])
//     println("${list.len(r.by_hour)}")      // 2
// ```
pub fn with_by_time(r: Rrule, by_hour: [Int], by_minute: [Int], by_second: [Int]) -> Rrule []
    Rrule {
        freq: r.freq,
        interval: r.interval,
        end: r.end,
        wkst: r.wkst,
        by_second: by_second[:],
        by_minute: by_minute[:],
        by_hour: by_hour[:],
        by_day: r.by_day,
        by_monthday: r.by_monthday,
        by_yearday: r.by_yearday,
        by_weekno: r.by_weekno,
        by_month: r.by_month,
        by_setpos: r.by_setpos }

// What a `BYxxx` part does in this rule: expand, limit, or nothing.
//
// RFC 5545 § 3.3.10's table, as a total function, with the two `BYDAY`
// footnotes folded in — which is why it takes the whole rule and not
// just the frequency.
//
// ```novo
// use rrulefreq
// use rrulespec
//
// fn main() [io]
//     let weekly = rrulespec.rule(RruleWeekly)
//     println(rrulespec.role_name(rrulespec.part_role(weekly, RrulePartByMonth)))
// ```
pub fn part_role(r: Rrule, part: rrulefreq.RrulePart) -> RruleExpansion []
    let f = r.freq
    match part
        RrulePartBySetPos   => RruleLimits
        RrulePartByMonth    => expands_only_under(f, [RruleYearly])
        RrulePartByWeekNo   => only_under(f, RruleYearly)
        RrulePartByYearDay  => year_day_role(f)
        RrulePartByMonthDay => month_day_role(f)
        RrulePartByDay      => day_role(r)
        RrulePartByHour     => finer_limit(f, 3)
        RrulePartByMinute   => finer_limit(f, 2)
        RrulePartBySecond   => finer_limit(f, 1)

// The role as a stable name: `"expands"`, `"limits"`,
// `"not-applicable"`.
//
// ```novo
// use rrulespec
//
// fn main() [io]
//     println(rrulespec.role_name(RruleLimits))      // limits
// ```
pub fn role_name(e: RruleExpansion) -> Str []
    match e
        RruleExpands       => "expands"
        RruleLimits        => "limits"
        RruleNotApplicable => "not-applicable"

// Whether the rule generates finitely many occurrences.
//
// True when the end is a `COUNT` or an `UNTIL`.  A rule with neither
// generates forever, and `rruleiter` will not answer a list for one.
//
// ```novo
// use rrulespec
//
// fn main() [io]
//     println("${rrulespec.is_finite(rrulespec.rule(RruleDaily))}")     // false
// ```
pub fn is_finite(r: Rrule) -> Bool []
    match r.end
        RruleNever => false
        _          => true

// The `COUNT`, or `None` when the rule does not end with one.
//
// ```novo
// use rrulespec
//
// fn main() [io]
//     match rrulespec.end_count(RruleNever)
//         Some(n) => println("${n}")
//         None    => println("this rule has no COUNT")
// ```
pub fn end_count(e: RruleEnd) -> ?Int []
    match e
        RruleCount(n) => Some(n)
        _             => None

// Every problem with the rule, or an empty list when there is none.
//
// Every problem and not the first, because a rule composed by hand
// usually has more than one and a caller fixing them one refusal per
// run is a caller who gives up.  The `UNTIL` value-type check is not
// here — it needs the `DTSTART` and lives in `rruleset.check_set`.
//
// ```novo
// use rrulespec
//
// fn main() [io]
//     let bad = rrulespec.with_interval(rrulespec.rule(RruleDaily), 0)
//     println("${list.len(rrulespec.check(bad))}")      // 1
// ```
pub fn check(r: Rrule) -> [rruleerror.RruleError] []
    var out: [rruleerror.RruleError] = []
    if r.interval < 1
        list.push(out, RruleIntervalNotPositive(r.interval))
    // A cursor builds every occurrence under a COUNT when it is made, so
    // a COUNT past a million is out of range rather than a request for
    // that much memory.
    if let RruleCount(n) = r.end
        if n < 1 or n > 1000000
            list.push(out, RruleValueOutOfRange("COUNT", n))
    check_range(out, "BYSECOND", r.by_second, 0, 60, false)
    check_range(out, "BYMINUTE", r.by_minute, 0, 59, false)
    check_range(out, "BYHOUR", r.by_hour, 0, 23, false)
    check_range(out, "BYMONTHDAY", r.by_monthday, 1, 31, true)
    check_range(out, "BYYEARDAY", r.by_yearday, 1, 366, true)
    check_range(out, "BYWEEKNO", r.by_weekno, 1, 53, true)
    check_range(out, "BYMONTH", r.by_month, 1, 12, false)
    check_range(out, "BYSETPOS", r.by_setpos, 1, 366, true)
    let freq = rrulefreq.freq_name(r.freq)
    if list.len(r.by_weekno) > 0 and r.freq != RruleYearly
        list.push(out, RruleByWeekNoNeedsYearly)
    if list.len(r.by_yearday) > 0 and part_role(r, RrulePartByYearDay) == RruleNotApplicable
        list.push(out, RrulePartNotApplicable("BYYEARDAY", freq))
    if list.len(r.by_monthday) > 0 and part_role(r, RrulePartByMonthDay) == RruleNotApplicable
        list.push(out, RrulePartNotApplicable("BYMONTHDAY", freq))
    for w in r.by_day
        if w.ordinal < -53 or w.ordinal > 53
            list.push(out, RruleValueOutOfRange("BYDAY", w.ordinal))
        else if w.ordinal != 0 and r.freq != RruleMonthly and r.freq != RruleYearly
            list.push(out,
                RruleOrdinalWeekdayNeedsMonthlyOrYearly(rrulefreq.weekday_code(w.weekday), w.ordinal))
    if list.len(r.by_setpos) > 0 and not has_other_part(r)
        list.push(out, RruleBySetPosWithoutOtherPart)
    out

// Expands under the frequencies listed, limits under every other.
fn expands_only_under(f: rrulefreq.RruleFreq, expanding: [rrulefreq.RruleFreq]) -> RruleExpansion
    if list.contains(expanding, f)
        RruleExpands
    else
        RruleLimits

// Expands under `f` if it is `only`, and does not apply otherwise.
fn only_under(f: rrulefreq.RruleFreq, only: rrulefreq.RruleFreq) -> RruleExpansion
    if f == only
        RruleExpands
    else
        RruleNotApplicable

// `BYYEARDAY`: limits under the three finest frequencies, expands
// under `YEARLY`, and does not apply under the three between.
fn year_day_role(f: rrulefreq.RruleFreq) -> RruleExpansion
    match f
        RruleYearly  => RruleExpands
        RruleDaily   => RruleNotApplicable
        RruleWeekly  => RruleNotApplicable
        RruleMonthly => RruleNotApplicable
        _            => RruleLimits

// `BYMONTHDAY`: expands under `MONTHLY` and `YEARLY`, does not apply
// under `WEEKLY`, and limits under the rest.
fn month_day_role(f: rrulefreq.RruleFreq) -> RruleExpansion
    match f
        RruleYearly  => RruleExpands
        RruleMonthly => RruleExpands
        RruleWeekly  => RruleNotApplicable
        _            => RruleLimits

// `BYDAY`, with the table's two footnotes.
fn day_role(r: Rrule) -> RruleExpansion
    match r.freq
        RruleWeekly  => RruleExpands
        RruleMonthly => limits_when(list.len(r.by_monthday) > 0)
        RruleYearly  => limits_when(list.len(r.by_monthday) > 0 or list.len(r.by_yearday) > 0)
        _            => RruleLimits

// Limits when `limit`, expands otherwise.
fn limits_when(limit: Bool) -> RruleExpansion
    if limit
        RruleLimits
    else
        RruleExpands

// The time parts: a part of rank `rank` (3 hour, 2 minute, 1 second)
// limits under a frequency that fine or finer and expands under a
// coarser one.
fn finer_limit(f: rrulefreq.RruleFreq, rank: Int) -> RruleExpansion
    if freq_rank(f) <= rank
        RruleLimits
    else
        RruleExpands

// The frequencies in order of length: 1 for `SECONDLY` to 7 for
// `YEARLY`.
fn freq_rank(f: rrulefreq.RruleFreq) -> Int
    match f
        RruleSecondly => 1
        RruleMinutely => 2
        RruleHourly   => 3
        RruleDaily    => 4
        RruleWeekly   => 5
        RruleMonthly  => 6
        RruleYearly   => 7

// Whether the rule carries a `BYxxx` part other than `BYSETPOS`.
fn has_other_part(r: Rrule) -> Bool
    let n = list.len(r.by_second) + list.len(r.by_minute) + list.len(r.by_hour) + list.len(r.by_day)
    n + list.len(r.by_monthday) + list.len(r.by_yearday) + list.len(r.by_weekno) + list.len(r.by_month) > 0

// Add a `RruleValueOutOfRange` to `out` for each value outside
// `low ..= high`, or outside `-high ..= -low` too when `signed`.
fn check_range(var out: [rruleerror.RruleError], part: Str, values: [Int], low: Int, high: Int,
               signed: Bool)
    for v in values
        let a = if signed and v < 0
            -v
        else
            v
        if a < low or a > high or v < 0 and not signed
            list.push(out, RruleValueOutOfRange(part, v))
