// rruleiter — generating the occurrences of a recurrence set.
//
// No function here answers an unbounded list.  `FREQ=DAILY` with no
// `COUNT` and no `UNTIL` is a legal rule with infinitely many
// occurrences, and it is the rule people write first.  The unbounded
// form is the cursor, which yields one occurrence per `step`.  Every
// function that answers a list takes its bound as an argument: a count
// or a window.  `is_bounded` is the question to ask first, and
// `count_occurrences` refuses a set that has no end.
//
// The generator works an interval at a time, because `BYSETPOS` does:
// "the last weekday of the month" is a property of the month's whole
// set.  A cursor can start at the interval holding any instant, so
// `cursor_from` and `after` do not generate what lies before it.
//
// Occurrences come out ascending with duplicates removed.  Two rules
// that both produce a Monday produce it once, and an `RDATE` equal to a
// generated occurrence does not double it (RFC 5545 section 3.8.5.3).

use std.list
use civil
use rruleerror
use rrulegen
use rrulespec
use rruleset

// A generation in progress over a recurrence set.
//
// A value: `step` answers a new cursor, so a caller may keep one,
// copy one, or restart from one it kept.
//
// ```novo
// use civil
// use rruleiter
// use rruleset
//
// fn main() [io]
//     match civil.date(2026, 1, 5)
//         Err(_) => println("not a date")
//         Ok(d)  =>
//             let s = rruleset.set(civil.datetime(d, civil.midnight()), true)
//             println("${rruleiter.cursor_position(rruleiter.cursor(s))}")    // 0
// ```
pub struct RruleCursor
    // The set being generated from.
    source: rruleset.RruleSet
    // Which interval of the set's first rule the last occurrence
    // yielded fell in, counting from zero at the `DTSTART`'s own.
    interval: Int
    // The finite part of the set not yet yielded, ascending, as civil
    // seconds since 1970-01-01T00:00:00: the `DTSTART`, the `RDATE`s,
    // and every occurrence of each rule that ends with a `COUNT`.
    pending: [Int]
    // How many occurrences this cursor has yielded.
    yielded: Int
    // The next occurrence yielded is at or after this civil second.
    floor: Int

// What one `step` produced.
//
// ```novo
// use civil
// use rruleiter
// use rruleset
//
// fn main() [io]
//     match civil.date(2026, 1, 5)
//         Err(_) => println("not a date")
//         Ok(d)  =>
//             let s = rruleset.set(civil.datetime(d, civil.midnight()), true)
//             let st = rruleiter.step(rruleiter.cursor(s))
//             match st.found
//                 Some(o) => println("${o.date.day}")
//                 None    => println("the recurrence is exhausted")
// ```
pub struct RruleStep
    // The cursor to hand to the next `step`.
    next: RruleCursor
    // The occurrence, or `None` when the recurrence is exhausted.  A
    // `None` is final: stepping the returned cursor answers `None`
    // again.
    found: ?civil.CivilDateTime

// A cursor at the start of a set.
//
// The first `step` yields the `DTSTART`, whether or not the rules
// would have produced it — see `rruleset.is_synchronized`.
//
// ```novo
// use civil
// use rruleiter
// use rruleset
//
// fn main() [io]
//     match civil.date(2026, 1, 5)
//         Err(_) => println("not a date")
//         Ok(d)  =>
//             let s = rruleset.set(civil.datetime(d, civil.midnight()), true)
//             println("${rruleiter.cursor_position(rruleiter.cursor(s))}")
// ```
pub fn cursor(s: rruleset.RruleSet) -> RruleCursor []
    start_at(s, -9223372036854775807 - 1)

// A cursor positioned so that the next `step` yields the first
// occurrence at or after an instant.
//
// The whole point of it is that it does not require generating
// everything before that instant one at a time: a caller painting
// next month's calendar starts there.  An instant before the
// `DTSTART` gives the same cursor as `cursor`.
//
// ```novo
// use civil
// use rruleiter
// use rruleset
//
// fn main() [io]
//     match civil.date(2026, 6, 1)
//         Err(_) => println("not a date")
//         Ok(d)  =>
//             let at = civil.datetime(d, civil.midnight())
//             let s = rruleset.set(at, true)
//             println("${rruleiter.cursor_position(rruleiter.cursor_from(s, at))}")
// ```
pub fn cursor_from(s: rruleset.RruleSet, at: civil.CivilDateTime) -> RruleCursor []
    start_at(s, rrulegen.seconds_of(at))

// Which interval the cursor has reached, counting from zero.
//
// The interval and not the occurrence count, because `BYSETPOS` makes
// the two different numbers and because an interval is what a caller
// resuming a generation has to be positioned on.
//
// ```novo
// use civil
// use rruleiter
// use rruleset
//
// fn main() [io]
//     match civil.date(2026, 1, 5)
//         Err(_) => println("not a date")
//         Ok(d)  =>
//             let s = rruleset.set(civil.datetime(d, civil.midnight()), true)
//             println("${rruleiter.cursor_position(rruleiter.cursor(s))}")    // 0
// ```
pub fn cursor_position(c: RruleCursor) -> Int []
    c.interval

// One occurrence, and the cursor that follows it.
//
// The only form that works for a rule with no end.
//
// ```novo
// use civil
// use rruleiter
// use rruleset
//
// fn main() [io]
//     match civil.date(2026, 1, 5)
//         Err(_) => println("not a date")
//         Ok(d)  =>
//             var c = rruleiter.cursor(rruleset.set(civil.datetime(d, civil.midnight()), true))
//             var n = 0
//             loop
//                 let st = rruleiter.step(c)
//                 match st.found
//                     None    => break
//                     Some(_) => n += 1
//                 if n >= 10
//                     break
//                 c = st.next
//             println("${n}")
// ```
pub fn step(c: RruleCursor) -> RruleStep []
    let s = c.source
    let excluded = seconds_list(s.exdates)
    var floor = c.floor
    var searching = true
    var found = 0
    var any = false
    while searching
        match earliest(c, floor)
            Some(o) =>
                found = o
                any = true
                searching = list.contains(excluded, o)
                floor = o + 1
            None    =>
                any = false
                searching = false
    if not any
        return RruleStep { next: c, found: None }
    var rest: [Int] = []
    for o in c.pending
        if o > found
            list.push(rest, o)
    let next = RruleCursor {
        source: s,
        interval: position_of(s, found),
        pending: rest,
        yielded: c.yielded + 1,
        floor: found + 1 }
    RruleStep { next: next, found: Some(rrulegen.civil_of(found)) }

// The first `limit` occurrences, or every occurrence when the rule
// ends before that.
//
// The bound is an argument and has no default, which is the whole of
// this module's safety story: there is no call here that can run
// forever by accident.
//
// ```novo
// use civil
// use rrulespec
// use rruleiter
// use rruleset
//
// fn main() [io]
//     match civil.date(2026, 1, 5)
//         Err(_) => println("not a date")
//         Ok(d)  =>
//             let s = rruleset.set(civil.datetime(d, civil.midnight()), true)
//             let daily = rruleset.with_rule(s, rrulespec.rule(RruleDaily))
//             println("${list.len(rruleiter.occurrences(daily, 5))}")     // 5
// ```
pub fn occurrences(s: rruleset.RruleSet, limit: Int) -> [civil.CivilDateTime] []
    var out: [civil.CivilDateTime] = []
    var c = cursor(s)
    while list.len(out) < limit
        let st = step(c)
        match st.found
            Some(o) => list.push(out, o)
            None    =>
                return out
        c = st.next
    out

// Every occurrence in a window, inclusive of both ends.
//
// The window is the bound, so this is safe on a rule with no end and
// is what a calendar view calls.
//
// ```novo
// use civil
// use rrulespec
// use rruleiter
// use rruleset
//
// fn main() [io]
//     match civil.date(2026, 1, 1)
//         Err(_) => println("not a date")
//         Ok(jan) =>
//             let from = civil.datetime(jan, civil.midnight())
//             let s = rruleset.with_rule(rruleset.set(from, true), rrulespec.rule(RruleDaily))
//             println("${list.len(rruleiter.between(s, from, from))}")    // 1
// ```
pub fn between(s: rruleset.RruleSet, from: civil.CivilDateTime,
               to: civil.CivilDateTime) -> [civil.CivilDateTime] []
    let last = rrulegen.seconds_of(to)
    var out: [civil.CivilDateTime] = []
    var c = cursor_from(s, from)
    var more = true
    while more
        let st = step(c)
        more = false
        if let Some(o) = st.found
            if rrulegen.seconds_of(o) <= last
                list.push(out, o)
                more = true
        c = st.next
    out

// The first occurrence strictly after an instant, or `None` when the
// rule ends before one.
//
// What a scheduler asks: given where we are, when is the next one.
//
// ```novo
// use civil
// use rrulespec
// use rruleiter
// use rruleset
//
// fn main() [io]
//     match civil.date(2026, 1, 5)
//         Err(_) => println("not a date")
//         Ok(d)  =>
//             let at = civil.datetime(d, civil.midnight())
//             let s = rruleset.with_rule(rruleset.set(at, true), rrulespec.rule(RruleDaily))
//             match rruleiter.after(s, at)
//                 Some(o) => println("${o.date.day}")       // 6
//                 None    => println("no further occurrence")
// ```
pub fn after(s: rruleset.RruleSet, at: civil.CivilDateTime) -> ?civil.CivilDateTime []
    step(start_at(s, rrulegen.seconds_of(at) + 1)).found

// The last occurrence strictly before an instant, or `None`.
//
// What an audit asks: which occurrence was this event, given when it
// happened.
//
// ```novo
// use civil
// use rrulespec
// use rruleiter
// use rruleset
//
// fn main() [io]
//     match civil.date(2026, 1, 5)
//         Err(_) => println("not a date")
//         Ok(d)  =>
//             let at = civil.datetime(d, civil.midnight())
//             let s = rruleset.with_rule(rruleset.set(at, true), rrulespec.rule(RruleDaily))
//             match rruleiter.before(s, at)
//                 Some(_) => println("there was an earlier one")
//                 None    => println("this is the first")
// ```
pub fn before(s: rruleset.RruleSet, at: civil.CivilDateTime) -> ?civil.CivilDateTime []
    let limit = rrulegen.seconds_of(at)
    var last: ?civil.CivilDateTime = None
    var c = cursor(s)
    var more = true
    while more
        let st = step(c)
        more = false
        if let Some(o) = st.found
            if rrulegen.seconds_of(o) < limit
                last = Some(o)
                more = true
        c = st.next
    last

// How many occurrences the set has in total.
//
// `RruleUnboundedRecurrence` when it has infinitely many, which is
// the refusal that keeps this function from being the one that hangs.
//
// ```novo
// use civil
// use rrulespec
// use rruleiter
// use rruleset
//
// fn main() [io]
//     match civil.date(2026, 1, 5)
//         Err(_) => println("not a date")
//         Ok(d)  =>
//             let s = rruleset.set(civil.datetime(d, civil.midnight()), true)
//             let daily = rruleset.with_rule(s, rrulespec.rule(RruleDaily))
//             match rruleiter.count_occurrences(daily)
//                 Ok(n)  => println("${n}")
//                 Err(_) => println("this rule has no end")
// ```
pub fn count_occurrences(s: rruleset.RruleSet) -> Result<Int, rruleerror.RruleError> []
    if not is_bounded(s)
        return Err(RruleUnboundedRecurrence)
    var n = 0
    var c = cursor(s)
    var more = true
    while more
        let st = step(c)
        more = st.found != None
        if more
            n = n + 1
        c = st.next
    Ok(n)

// Whether the set has finitely many occurrences.
//
// True when every rule in it ends, and true for a set with no rules
// at all.  The question `count_occurrences` refuses on, asked
// beforehand.
//
// ```novo
// use civil
// use rruleiter
// use rruleset
//
// fn main() [io]
//     match civil.date(2026, 1, 5)
//         Err(_) => println("not a date")
//         Ok(d)  =>
//             let s = rruleset.set(civil.datetime(d, civil.midnight()), true)
//             println("${rruleiter.is_bounded(s)}")       // true
// ```
pub fn is_bounded(s: rruleset.RruleSet) -> Bool []
    for r in s.rules
        if not rrulespec.is_finite(r)
            return false
    true

// Civil seconds for each date-time.
fn seconds_list(xs: [civil.CivilDateTime]) -> [Int]
    var out: [Int] = []
    for x in xs
        list.push(out, rrulegen.seconds_of(x))
    out

// A cursor over `s` whose first occurrence is at or after civil second
// `floor`.
fn start_at(s: rruleset.RruleSet, floor: Int) -> RruleCursor
    var finite = seconds_list(s.rdates)
    list.push(finite, rrulegen.seconds_of(s.dtstart))
    for r in s.rules
        if rrulespec.end_count(r.end) != None
            for o in rrulegen.counted(rrulegen.plan(r, s.dtstart))
                list.push(finite, o)
    var pending: [Int] = []
    for o in rrulegen.sorted_set(finite)
        if o >= floor
            list.push(pending, o)
    RruleCursor { source: s,
        interval: position_of(s, floor),
        pending: pending,
        yielded: 0,
        floor: floor }

// The earliest occurrence at or after `floor`, before exclusion, or
// `None`.
fn earliest(c: RruleCursor, floor: Int) -> ?Int
    var best: ?Int = None
    for o in c.pending
        if o >= floor
            best = earlier(best, o)
    for r in c.source.rules
        if rrulespec.end_count(r.end) == None
            if let Some(o) = rrulegen.first_from(rrulegen.plan(r, c.source.dtstart), floor)
                best = earlier(best, o)
    best

// The earlier of `best` and `o`, where `best` is `None` before any
// candidate has been seen.
fn earlier(best: ?Int, o: Int) -> ?Int
    match best
        Some(b) =>
            if b < o
                Some(b)
            else
                Some(o)
        None    => Some(o)

// The interval of the set's first rule that civil second `o` falls in,
// or 0 for a set with no rules.
fn position_of(s: rruleset.RruleSet, o: Int) -> Int
    if list.len(s.rules) == 0
        return 0
    rrulegen.interval_of(rrulegen.plan(s.rules[0], s.dtstart), o)
