// tests/generator_tests.nv — the generator at its edges: the defaults
// taken from DTSTART, the finer frequencies skipping the days no part
// keeps, week numbers and year days counted from the end, ordinals
// within the year, and rules with nothing to yield.
//
// Each series is python-dateutil's answer for the same rule and start.

use std.test
use std.str
use std.list
use civil
use rruleerror
use rruleiter
use rruleparse
use rrulespec
use rruleset

// A field of `YYYYMMDDTHHMMSS` as a number.
fn field(text: Str, from: Int, to: Int) -> Int
    str.to_int(str.slice(text, from, to)) ?? 0

// A civil date-time from `YYYYMMDDTHHMMSS`.
fn at(text: Str) -> civil.CivilDateTime
    let d = CivilDate { year: field(text, 0, 4), month: field(text, 4, 6), day: field(text, 6, 8) }
    let t = CivilTime { hour: field(text, 9, 11),
        minute: field(text, 11, 13),
        second: field(text, 13, 15),
        nano: 0 }
    civil.datetime(d, t)

// `n` in at least `width` digits.
fn pad(n: Int, width: Int) -> Str
    str.pad_left("${n}", width, "0")

// The occurrences as `YYYYMMDDTHHMMSS`, comma-separated.
fn stamps(xs: [civil.CivilDateTime]) -> Str
    var out: [Str] = []
    for x in xs
        let d = x.date
        let t = x.time
        list.push(out,
            "${pad(d.year, 4)}${pad(d.month, 2)}${pad(d.day, 2)}T${pad(t.hour, 2)}${pad(t.minute, 2)}${pad(t.second, 2)}")
    str.join(out, ",")

// The first `n` occurrences of `rule` from `start`.
fn first(start: Str, rule: Str, n: Int) -> Str
    match rruleparse.parse(rule)
        Err(e) => "refused: ${rruleerror.code(e)}"
        Ok(r)  => stamps(rruleiter.occurrences(rruleset.with_rule(rruleset.set(at(start), false), r), n))

@test
fn test_a_bare_rule_takes_its_day_and_time_from_dtstart()
    // The 29th of February recurs only in leap years.
    test.assert_eq(first("20240229T100000", "FREQ=YEARLY", 3), "20240229T100000,20280229T100000,20320229T100000")
    test.assert_eq(first("20260131T093000", "FREQ=MONTHLY", 3), "20260131T093000,20260331T093000,20260531T093000")

@test
fn test_the_finer_frequencies_skip_the_days_no_part_keeps()
    test.assert_eq(first("20260131T220000", "FREQ=HOURLY;BYMONTH=3", 3),
                   "20260131T220000,20260301T000000,20260301T010000")
    test.assert_eq(first("20260105T000000", "FREQ=HOURLY;INTERVAL=25;BYDAY=MO", 4),
                   "20260105T000000,20260112T070000,20260119T140000,20260126T210000")
    test.assert_eq(first("20260105T100500", "FREQ=SECONDLY;BYSECOND=0,30;BYMINUTE=5", 4),
                   "20260105T100500,20260105T100530,20260105T110500,20260105T110530")
    test.assert_eq(first("20260105T060000", "FREQ=MINUTELY;BYMINUTE=0;BYHOUR=6", 3),
                   "20260105T060000,20260106T060000,20260107T060000")

@test
fn test_weeks_and_days_count_from_the_end_of_the_year()
    test.assert_eq(first("20270103T090000", "FREQ=YEARLY;BYWEEKNO=-1;BYDAY=SU", 3),
                   "20270103T090000,20280102T090000,20281231T090000")
    test.assert_eq(first("20241231T090000", "FREQ=YEARLY;BYYEARDAY=-1", 3),
                   "20241231T090000,20251231T090000,20261231T090000")
    test.assert_eq(first("20261225T090000", "FREQ=YEARLY;BYDAY=-1FR", 3),
                   "20261225T090000,20271231T090000,20281229T090000")
    // Week 1 can start in December: 2024-12-30 is the Monday of week 1
    // of 2025.
    test.assert_eq(first("20241230T090000", "FREQ=YEARLY;BYWEEKNO=1;BYDAY=MO", 3),
                   "20241230T090000,20251229T090000,20270104T090000")

@test
fn test_a_rule_with_nothing_to_yield_leaves_the_dtstart_alone()
    // There is no sixth Monday in a month, and no 30th of February.
    test.assert_eq(first("20260330T090000", "FREQ=MONTHLY;BYDAY=MO;BYSETPOS=6", 3), "20260330T090000")
    test.assert_eq(first("20260130T090000", "FREQ=YEARLY;BYMONTH=2;BYMONTHDAY=30", 2), "20260130T090000")

@test
fn test_an_until_date_includes_its_whole_day()
    let r = rrulespec.with_end(rrulespec.rule(RruleDaily), RruleUntil(at("20260107T000000"), RruleUntilDate))
    let s = rruleset.with_rule(rruleset.set(at("20260105T090000"), false), r)
    test.assert_eq(stamps(rruleiter.occurrences(s, 10)), "20260105T090000,20260106T090000,20260107T090000")

@test
fn test_a_count_counts_an_unsynchronised_dtstart()
    // 2026-01-07 is a Wednesday; the rule wants Mondays.
    let s = rruleset.with_rule(rruleset.set(at("20260107T090000"), false),
                               rruleparse.parse("FREQ=WEEKLY;BYDAY=MO;COUNT=3")!)
    test.assert_eq(stamps(rruleiter.occurrences(s, 10)), "20260107T090000,20260112T090000,20260119T090000")
    test.assert_eq(rruleset.is_synchronized(s), false)
    // A COUNT that the rule cannot fill ends with what it has.
    let never = rruleset.with_rule(rruleset.set(at("20260130T090000"), false),
                                   rruleparse.parse("FREQ=YEARLY;BYMONTH=2;BYMONTHDAY=30;COUNT=3")!)
    test.assert_eq(stamps(rruleiter.occurrences(never, 10)), "20260130T090000")

@test
fn test_a_series_before_1970_counts_its_days_the_same_way()
    // 1969-12-29 was a Monday.
    test.assert_eq(first("19691229T090000", "FREQ=WEEKLY;BYDAY=MO,SU;COUNT=3", 3),
                   "19691229T090000,19700104T090000,19700105T090000")
    test.assert_eq(first("19691231T235959", "FREQ=SECONDLY;COUNT=2", 2), "19691231T235959,19700101T000000")

@test
fn test_a_set_with_no_rules_is_its_dates()
    let s = rruleset.with_rdate(rruleset.set(at("20260105T090000"), false), at("20260101T090000"))
    test.assert_eq(stamps(rruleiter.occurrences(s, 5)), "20260101T090000,20260105T090000")
    let c = rruleiter.step(rruleiter.cursor(s)).next
    test.assert_eq(rruleiter.cursor_position(c), 0)

@test
fn test_an_until_of_the_wrong_kind_names_both_kinds()
    let date_set = rruleset.set(at("20260105T000000"), true)
    let utc = rrulespec.with_end(rrulespec.rule(RruleDaily), RruleUntil(at("20260110T000000"), RruleUntilUtc))
    let local = rrulespec.with_end(rrulespec.rule(RruleDaily), RruleUntil(at("20260110T000000"), RruleUntilLocal))
    let problems = rruleset.check_set(rruleset.with_rule(rruleset.with_rule(date_set, utc), local))
    var named: [Str] = []
    for e in problems
        list.push(named, rruleerror.message(e))
    test.assert_eq(named,
        ["UNTIL is a utc value and DTSTART a date one", "UNTIL is a local value and DTSTART a date one"])
    let timed = rruleset.with_rule(date_set, rrulespec.with_by_time(rrulespec.rule(RruleDaily), [9], [30], [15]))
    test.assert_eq(list.len(rruleset.check_set(timed)), 3)

@test
fn test_a_rule_that_yields_nothing_is_not_synchronised()
    let s = rruleset.with_rule(rruleset.set(at("20260330T090000"), false),
                               rruleparse.parse("FREQ=MONTHLY;BYDAY=MO;BYSETPOS=6")!)
    test.assert_eq(rruleset.is_synchronized(s), false)
    // 1969-12-01 was a Monday.
    test.assert_eq(first("19691201T090000", "FREQ=WEEKLY;BYDAY=MO", 2), "19691201T090000,19691208T090000")

@test
fn test_a_date_until_on_a_timed_set_is_refused()
    let r = rrulespec.with_end(rrulespec.rule(RruleDaily), RruleUntil(at("20260110T000000"), RruleUntilDate))
    let problems = rruleset.check_set(rruleset.with_rule(rruleset.set(at("20260105T090000"), false), r))
    test.assert_eq(rruleerror.message(problems[0]), "UNTIL is a date value and DTSTART a local one")
    let bad = rruleset.with_rule(rruleset.set(at("20260105T090000"), false),
                                 rrulespec.with_interval(rrulespec.rule(RruleDaily), 0))
    test.assert_eq(rruleerror.code(rruleset.check_set(bad)[0]), "interval-not-positive")
